[Unit]
Description=DETai onboarding welcome
After=network-online.target ecosystem-api.service
Wants=network-online.target

[Service]
Type=simple
User=psy-ru
WorkingDirectory=/home/psy-ru/DETai-org/onboarding
Environment=PYTHONPATH=/home/psy-ru/DETai-org/onboarding
EnvironmentFile=/home/psy-ru/DETai-org/server-operations/detai-onboarding.env
ExecStart=/usr/bin/python3 -m bot
Restart=always
RestartSec=5
RestartPreventExitStatus=78
ProtectHome=no
PrivateTmp=true

[Install]
WantedBy=multi-user.target
